# Homebrew formula template. Rendered by CI into a real
# `kndo.rb` and committed to the tap repo (e.g. `eulke/homebrew-tap`) — this file itself never
# ships anywhere, it's the source `update-tap`'s job substitutes into.
#
# Placeholders, substituted by the release workflow from that run's own resolved values:
#   {{VERSION}}             — e.g. 1.2.0 (no leading "v")
#   {{SHA256_MACOS_ARM64}}   {{SHA256_MACOS_X86_64}}
#   {{SHA256_LINUX_ARM64}}   {{SHA256_LINUX_X86_64}}
#
# The formula only ever downloads a precompiled binary — it never compiles anything on the
# user's machine.
class Kndo < Formula
  desc "Multi-language static analyzer for unused code, dependency hygiene, and structural risk"
  homepage "https://github.com/eulke/kondo"
  version "{{VERSION}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/eulke/kondo/releases/download/v{{VERSION}}/kndo-v{{VERSION}}-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA256_MACOS_ARM64}}"
    end
    on_intel do
      url "https://github.com/eulke/kondo/releases/download/v{{VERSION}}/kndo-v{{VERSION}}-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA256_MACOS_X86_64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/eulke/kondo/releases/download/v{{VERSION}}/kndo-v{{VERSION}}-aarch64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/eulke/kondo/releases/download/v{{VERSION}}/kndo-v{{VERSION}}-x86_64-unknown-linux-musl.tar.gz"
      sha256 "{{SHA256_LINUX_X86_64}}"
    end
  end

  def install
    bin.install "kndo"
  end

  test do
    system "#{bin}/kndo", "--version"
  end
end
