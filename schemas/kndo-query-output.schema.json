{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QueryJsonEnvelope",
  "description": "The full `--format json` query envelope — also `cargo xtask gen-schema`'s\nsecond root type. `run` is `Option` only so [`QueryResult::to_json_line`] can omit it on\nevery `kndo query` line after the first (\"run appearing only on the first line\").",
  "type": "object",
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Diagnostic"
      }
    },
    "kndo_version": {
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/QueryEcho"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResultEntry"
      }
    },
    "run": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunEcho"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kndo_version",
    "query",
    "status",
    "results",
    "diagnostics"
  ],
  "$defs": {
    "AffectedRoot": {
      "description": "One root whose liveness evidence passes through the impacted node — retesting starts here.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/QNodeRef"
        }
      },
      "required": [
        "kind",
        "node"
      ]
    },
    "ByColor": {
      "type": "object",
      "properties": {
        "production": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "test-only": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "tooling-only": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "production",
        "test-only",
        "tooling-only",
        "unreachable"
      ]
    },
    "Confidence": {
      "description": "Per-edge strength. Ordered by strength: `Possible < Probable < Certain`, so `max()` yields\nthe strongest evidence and \"edges at least as strong as τ\" is a simple `>=`.",
      "type": "string",
      "enum": [
        "possible",
        "probable",
        "certain"
      ]
    },
    "DeclarationInfo": {
      "type": "object",
      "properties": {
        "exported": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/NodeSpan"
        },
        "visibility": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "span",
        "exported",
        "visibility"
      ]
    },
    "Degree": {
      "type": "object",
      "properties": {
        "in_by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "out_by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        }
      },
      "required": [
        "in_by_kind",
        "out_by_kind"
      ]
    },
    "DependencyInfo": {
      "type": "object",
      "properties": {
        "importing_files": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "manifest_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "used": {
          "type": "boolean"
        }
      },
      "required": [
        "manifest_scopes",
        "importing_files",
        "used"
      ]
    },
    "DescribeResult": {
      "type": "object",
      "properties": {
        "declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclarationInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "declared_symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QNodeRef"
          }
        },
        "degree": {
          "$ref": "#/$defs/Degree"
        },
        "dependency": {
          "anyOf": [
            {
              "$ref": "#/$defs/DependencyInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "duplication": {
          "description": "Duplication groups this node belongs to. Plural because a symbol with two substantial\nclosures can be in two different groups.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DuplicationInfo"
          }
        },
        "elided": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "file": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "description": "Per-shape measurements, ordered by `shape_ordinal`. Empty for a node that owns no\ncallable shape — a type, a file, a dependency (RFC 0007 §4.2).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShapeMetrics"
          }
        },
        "node": {
          "$ref": "#/$defs/QNodeRef"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackageInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "reached_by_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QNodeRef"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "node",
        "degree",
        "reached_by_roots",
        "findings",
        "sources",
        "elided"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/DiagnosticLevel"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "The file this diagnostic is about, when there is one — `None` for project-level\ndiagnostics (e.g. \"cannot walk the project root\"). A diagnostic merged from many\nfiles without this field would be unattributable; adapters emit diagnostics scoped\nto the file they're extracting, the core fills this in.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "message"
      ]
    },
    "DiagnosticLevel": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "warn",
            "info"
          ]
        },
        {
          "description": "The run could not do what was asked (the exit-2 tier): a requested mode is\nimpossible (`--diff` base that doesn't resolve), not merely degraded. Frontends exit 2\nwhen any error-level diagnostic is present — reporting zero findings because the\nanalysis never ran must never read as a clean pass (a Warn here\nwould let a typo'd base ref fail open in CI).",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "DuplicationInfo": {
      "description": "One duplication group this node belongs to: the `duplicate` finding that named it, and\nevery member including this node.\n\nRead off the findings the run already computed, not a second index on the graph — a\ncross-file fingerprint index would need its own invalidation semantics in the incremental\npatch, for an answer the analysis has already produced.",
      "type": "object",
      "properties": {
        "finding": {
          "description": "The `duplicate` finding's id — the group's stable identity.",
          "type": "string"
        },
        "members": {
          "description": "Every member's selector, in the finding's own order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "finding",
        "members"
      ]
    },
    "FileInfo": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "origin"
      ]
    },
    "FindResult": {
      "type": "object",
      "properties": {
        "elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QNodeRef"
          }
        }
      },
      "required": [
        "matches",
        "elided"
      ]
    },
    "Hop": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/QNodeRef"
        },
        "via": {
          "$ref": "#/$defs/QEdgeRef"
        }
      },
      "required": [
        "node",
        "via"
      ]
    },
    "IfDeleted": {
      "description": "`--if-deleted`'s simulation result: the finding flips removal would cause,\ncomputed on a patched copy of the graph — nothing is written.",
      "type": "object",
      "properties": {
        "freed_dependencies": {
          "description": "Declared dependencies whose every importing file is in the deleted set — zero import\nedges remain, the exact evidence `dependency_hygiene` calls `unused`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "newly_test_only": {
          "description": "Production nodes that only tests would still reach — each a would-be `test-only`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QNodeRef"
          }
        },
        "newly_test_only_elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "newly_unreachable": {
          "description": "Files and symbols (outside the deleted set) that lose reachability entirely — each a\nwould-be `unused` finding.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QNodeRef"
          }
        },
        "newly_unreachable_elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "newly_unreachable",
        "newly_unreachable_elided",
        "newly_test_only",
        "newly_test_only_elided",
        "freed_dependencies"
      ]
    },
    "ImpactResult": {
      "type": "object",
      "properties": {
        "affected": {
          "description": "The reverse closure — who is affected if this node changes — depth-annotated, capped.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeighborEntry"
          }
        },
        "affected_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AffectedRoot"
          }
        },
        "affected_roots_elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "by_color": {
          "$ref": "#/$defs/ByColor"
        },
        "elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "if_deleted": {
          "anyOf": [
            {
              "$ref": "#/$defs/IfDeleted"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/QNodeRef"
        }
      },
      "required": [
        "node",
        "affected",
        "by_color",
        "elided",
        "affected_roots",
        "affected_roots_elided"
      ]
    },
    "NeighborEntry": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/QNodeRef"
        },
        "via": {
          "$ref": "#/$defs/QEdgeRef"
        }
      },
      "required": [
        "node",
        "via",
        "depth"
      ]
    },
    "NeighborsResult": {
      "type": "object",
      "properties": {
        "by_color": {
          "$ref": "#/$defs/ByColor"
        },
        "elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeighborEntry"
          }
        },
        "node": {
          "$ref": "#/$defs/QNodeRef"
        }
      },
      "required": [
        "node",
        "entries",
        "by_color",
        "elided"
      ]
    },
    "NodeSpan": {
      "description": "`{path, start, end}` — the query envelope's `NodeRef.span`/`EdgeRef.site` building\nblock, distinct from [`crate::engine::Location`]'s split `path`/`range` because\nthe query schema bundles them into one object.",
      "type": "object",
      "properties": {
        "end": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "start": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ]
    },
    "PackageInfo": {
      "type": "object",
      "properties": {
        "dependents": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "mode": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "files",
        "dependents"
      ]
    },
    "Path": {
      "type": "object",
      "properties": {
        "hops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hop"
          }
        },
        "weakest_confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "required": [
        "hops",
        "weakest_confidence"
      ]
    },
    "ProjectPath": {
      "description": "Project-relative path with `/` separators, the only path form that crosses the adapter\nboundary (case handling and symlink resolution are the core's discovery concern).",
      "type": "string"
    },
    "QEdgeRef": {
      "description": "The query envelope's `EdgeRef` building block.",
      "type": "object",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "edge": {
          "type": "string"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "edge",
        "confidence"
      ]
    },
    "QNodeRef": {
      "description": "The query envelope's `NodeRef` building block.",
      "type": "object",
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeSpan"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "selector",
        "kind"
      ]
    },
    "QueryEcho": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verb": {
          "type": "string"
        }
      },
      "required": [
        "verb",
        "selectors"
      ]
    },
    "ResultEntry": {
      "description": "One `results[]` entry — either a verb-specific success shape or an inline per-selector\nfailure (\"a failed selector yields an inline `{status, …}` entry without\nfailing its siblings\").",
      "anyOf": [
        {
          "$ref": "#/$defs/FindResult"
        },
        {
          "$ref": "#/$defs/DescribeResult"
        },
        {
          "$ref": "#/$defs/NeighborsResult"
        },
        {
          "$ref": "#/$defs/TraceResult"
        },
        {
          "$ref": "#/$defs/ImpactResult"
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "selector",
            "message"
          ]
        }
      ]
    },
    "RunEcho": {
      "type": "object",
      "properties": {
        "cache": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "cache",
        "duration_ms"
      ]
    },
    "ShapeMetrics": {
      "description": "One callable **shape**'s measurements — a declaration's own body, or one callable nested\ninside it. A symbol can own several ([`crate::graph::SymbolMetrics`]'s doc), so `describe`\nreports a list ordered by `shape_ordinal` rather than one set of numbers that would\nsilently be the first shape's.",
      "type": "object",
      "properties": {
        "coverage": {
          "description": "Covered fraction of this shape's instrumented lines, when a report was ingested and\ninstruments them. **Absent means unknown, never zero**: `crap` scores an uninstrumented\nfunction pessimistically at 0, but reporting that 0 here would be a fabricated\nmeasurement — the rule [`crate::coverage::CoverageMap::function_coverage`] states.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "crap": {
          "description": "`cyclomatic² × (1 - coverage)³ + cyclomatic`, from the same function `crap` scores\nwith. Absent for the same reason `coverage` is.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "cyclomatic": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "loc": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "shape_ordinal": {
          "description": "0 for the declaration's own body, 1..N for nested callables in pre-order.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "span": {
          "description": "This shape's own extent, not the symbol's.",
          "$ref": "#/$defs/NodeSpan"
        },
        "token_count": {
          "description": "Normalized-stream token count — the basis of the duplication ratio.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "shape_ordinal",
        "span",
        "cyclomatic",
        "loc",
        "token_count"
      ]
    },
    "Span": {
      "description": "1-indexed line/column span, `start` inclusive, `end` exclusive. Serializes as the\n`[line, col]` pair shape the output schema uses, not an\nobject — tuples serialize as JSON arrays by default.",
      "type": "object",
      "properties": {
        "end": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        },
        "start": {
          "type": "array",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "TraceResult": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/QNodeRef"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Path"
          }
        },
        "paths_elided": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "to": {
          "$ref": "#/$defs/QNodeRef"
        }
      },
      "required": [
        "from",
        "to",
        "paths",
        "paths_elided"
      ]
    }
  }
}
