// The external-plugin world — the same surface native plugins get, containment
// model included: findings land under host-assembled namespaced categories, roots
// apply only from a component whose `mutates-graph` export answers true (and any
// active mutating plugin bypasses the persisted graph cache, WASM and native alike),
// and everything misdirected drops with a described line on the contribution.
//
// `mutates-graph` is a MANDATORY export — the WIT spelling of the native trait
// method having no default: a component that has not decided does not instantiate.
//
// The read surface is deliberately the native one: graph paths and membership, plus
// budgeted, glob-scoped content reads. `read-file` answers from a snapshot the host
// prefetched before instantiation (every declared-glob match, budget-limited) — a
// WASM plugin's content budget is charged by declaration, not by demand, and no
// call here touches the filesystem mid-round.

world plugin {
    use types.{plugin-spec, contributed-root, contributed-finding};

    /// Every path in the assembled graph, in path order.
    import graph-paths: func() -> list<string>;

    /// Membership without the full list.
    import graph-contains: func(path: string) -> bool;

    /// One file's bytes, scoped to the spec's `requested-file-access` globs and the
    /// host's per-plugin budget. `none` covers every miss uniformly: no glob match,
    /// unknown path, budget cut — the cut itself is reported on the contribution.
    import read-file: func(path: string) -> option<list<u8>>;

    /// Called once at load; cached. External components claiming the `kndo:`
    /// coordinate namespace are rejected here.
    export spec: func() -> plugin-spec;

    /// Whether this component contributes graph roots. Load-bearing, not a hint —
    /// see the world doc above.
    export mutates-graph: func() -> bool;

    /// Roots the language cannot know. Called only when `mutates-graph` is true.
    export contribute-roots: func() -> list<contributed-root>;

    /// Advisory findings under the spec's declared rules; undeclared rules drop
    /// with a described line.
    export report-findings: func() -> list<contributed-finding>;
}
