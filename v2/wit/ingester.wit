// The coverage-ingester world — deliberately UNIDIRECTIONAL: no imports. The host
// locates the report through the spec's `requested-file-access` entries read as
// well-known, root-relative report paths (run output is gitignored, so the
// discovery walk never sees it — the well-known channel is the sanctioned way in),
// pushes the raw bytes to the guest, and the guest answers with records: what the
// report STATES, never a line table (line tables need source contents, which a
// guest never sees — the host assembles coverage from records and the run's own
// files, uniformly for every ingester).
//
// A component targets exactly one world, so an ingester carries no graph hooks —
// the host applies the `mutates-graph == false` posture structurally, keeping both
// graph fast paths alive. Between competing ingesters, first parseable answer wins
// in registration order, same as native.

world coverage-ingester {
    use types.{plugin-spec, coverage-records};

    /// Called once at load; cached. Same `kndo:` namespace rejection as plugins.
    export spec: func() -> plugin-spec;

    /// Parse one report. `path` is the project-relative report location (context
    /// for formats whose keys depend on where the report lives); `content` is its
    /// raw bytes. `none` when the bytes are not this ingester's format — the host
    /// tries the next candidate path, then the next ingester.
    export ingest: func(path: string, content: list<u8>) -> option<coverage-records>;
}
