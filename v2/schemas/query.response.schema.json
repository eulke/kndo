{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "results": {
      "description": "1:1 with the request's `inputs`, in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Outcome"
      }
    },
    "schema": {
      "description": "Stamped from [`QUERY_SCHEMA`]; a consumer of any other envelope version\nfails loudly instead of drifting.",
      "type": "string"
    },
    "verb": {
      "$ref": "#/$defs/Verb"
    }
  },
  "required": [
    "schema",
    "verb",
    "results"
  ],
  "$defs": {
    "Affected": {
      "type": "object",
      "properties": {
        "depth": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        }
      },
      "required": [
        "node",
        "depth"
      ]
    },
    "Confidence": {
      "description": "Ordered by strength, so `max()` and threshold comparisons read naturally.\nClosed by design: a fourth tier would change what every existing threshold means —\nthat is a semantic contract change, not growth.",
      "type": "string",
      "enum": [
        "possible",
        "probable",
        "certain"
      ]
    },
    "DeclarationFacts": {
      "type": "object",
      "properties": {
        "exported_as": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "reach": {
          "description": "The reach as the contract spells it: `private`, `scoped:<token>`, or\n`exported`.",
          "type": "string"
        }
      },
      "required": [
        "reach"
      ]
    },
    "DescribeAnswer": {
      "type": "object",
      "properties": {
        "declaration": {
          "description": "Symbol subjects only: the declaration's own facts.",
          "anyOf": [
            {
              "$ref": "#/$defs/DeclarationFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "description": "File subjects only: the file's own facts.",
          "anyOf": [
            {
              "$ref": "#/$defs/FileFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "description": "Ids of current findings on this exact subject.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kept_by": {
          "description": "A preview of what keeps it alive (symbols only) — `used-by` lists them\nall; `more: true` says the preview is not the whole story.",
          "anyOf": [
            {
              "$ref": "#/$defs/KeptPreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        }
      },
      "required": [
        "node",
        "findings"
      ]
    },
    "EdgeRef": {
      "description": "One piece of evidence keeping a node alive — [`navigate::Keeper`], serialized.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "site": {
          "description": "The concrete source site, when the keeper has one (roots and entry\nsurface are facts, not sites).",
          "anyOf": [
            {
              "$ref": "#/$defs/SiteRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "ExplainAnswer": {
      "type": "object",
      "properties": {
        "finding": {
          "$ref": "#/$defs/FindingBrief"
        },
        "subject": {
          "description": "The subject, described in full — for `unused` the empty keeper preview\nIS the why; for `internal-only` the scoped reach and in-file keepers\nare; category-specific evidence deepens per analysis over time.",
          "$ref": "#/$defs/DescribeAnswer"
        }
      },
      "required": [
        "finding",
        "subject"
      ]
    },
    "FileFacts": {
      "type": "object",
      "properties": {
        "declarations": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "extension": {
          "description": "The extension that claimed the file.",
          "type": "string"
        },
        "importers": {
          "description": "Files importing this one (bindings and whole-surface alike).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "imports": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "extension",
        "declarations",
        "imports",
        "importers"
      ]
    },
    "FindAnswer": {
      "type": "object",
      "properties": {
        "elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeRef"
          }
        }
      },
      "required": [
        "matches",
        "elided"
      ]
    },
    "FindingBrief": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "confidence",
        "message",
        "location"
      ]
    },
    "IfDeleted": {
      "description": "Typed reachability flips from simulating the removal — graph facts, never\nfabricated finding objects: those findings don't exist until the edit does.",
      "type": "object",
      "properties": {
        "newly_test_only": {
          "description": "Files production no longer reaches but tests still do.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeRef"
          }
        },
        "newly_test_only_elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "newly_unreachable": {
          "description": "Files no color reaches once the node is gone (file subjects).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeRef"
          }
        },
        "newly_unreachable_elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "orphans": {
          "description": "Symbol subjects: declarations whose EVERY reference lives inside the\ndeleted declaration's span — they lose their last reference with it.\nA precise subset, not a re-judgment.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeRef"
          }
        },
        "orphans_elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "newly_unreachable",
        "newly_unreachable_elided",
        "newly_test_only",
        "newly_test_only_elided",
        "orphans",
        "orphans_elided"
      ]
    },
    "ImpactAnswer": {
      "type": "object",
      "properties": {
        "affected": {
          "description": "The reverse closure: everything that transitively depends on the\nnode's file, nearest first.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Affected"
          }
        },
        "affected_roots": {
          "description": "Root kinds whose reach passes through the affected set.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RootSet"
          }
        },
        "by_color": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "if_deleted": {
          "anyOf": [
            {
              "$ref": "#/$defs/IfDeleted"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        }
      },
      "required": [
        "node",
        "affected",
        "by_color",
        "elided",
        "affected_roots"
      ]
    },
    "ImportUse": {
      "type": "object",
      "properties": {
        "names": {
          "description": "Bound names, empty for whole-surface shapes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "$ref": "#/$defs/ProjectPath"
        }
      },
      "required": [
        "target",
        "names"
      ]
    },
    "KeptPreview": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeRef"
          }
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "more"
      ]
    },
    "LineSpan": {
      "description": "1-based, inclusive line range — display data the engine derives from the\nsubject's byte span against the file's actual newlines. Lines are exact in any\nencoding (a newline is one byte); columns are deliberately absent — every\ninterchange format counts them in its own unit, and a slightly-wrong column is\nworse than none.",
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "NodeRef": {
      "description": "A node, addressable: feed `selector` straight back into any verb.",
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/ReachColor"
        },
        "kind": {
          "description": "`file`, or the declaration's symbol kind.",
          "type": "string"
        },
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "selector": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "kind",
        "color"
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            }
          },
          "anyOf": [
            {
              "$ref": "#/$defs/FindAnswer"
            },
            {
              "$ref": "#/$defs/DescribeAnswer"
            },
            {
              "$ref": "#/$defs/UsesAnswer"
            },
            {
              "$ref": "#/$defs/UsedByAnswer"
            },
            {
              "$ref": "#/$defs/TraceAnswer"
            },
            {
              "$ref": "#/$defs/ImpactAnswer"
            },
            {
              "$ref": "#/$defs/ExplainAnswer"
            }
          ],
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "not-found"
            }
          },
          "required": [
            "status",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "status",
            "input",
            "message"
          ]
        }
      ]
    },
    "ProjectPath": {
      "description": "A `/`-separated, project-relative path. The one path spelling that crosses crate\nboundaries; OS paths stay at the discovery edge.",
      "type": "string"
    },
    "ReachColor": {
      "description": "The one projection of the three reachability floods into the color a\nnavigator speaks: `production` wins, then `test-only`, then `tooling-only`,\nthen `unreachable` — the same precedence the analyses' judgments imply.",
      "type": "string",
      "enum": [
        "production",
        "test-only",
        "tooling-only",
        "unreachable"
      ]
    },
    "ReferenceUse": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "resolved": {
          "description": "Where the name resolves, when the pool holds exactly one declaration\nwith it — ambiguity stays honest by absence.",
          "anyOf": [
            {
              "$ref": "#/$defs/NodeRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "count"
      ]
    },
    "RootSet": {
      "type": "string",
      "enum": [
        "production",
        "test",
        "tooling"
      ]
    },
    "Severity": {
      "description": "Declared worst-first so `Ord` is display order; gates compare via\n[`Severity::at_least`], the one place the inversion lives.",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "SiteRef": {
      "type": "object",
      "properties": {
        "lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/ProjectPath"
        }
      },
      "required": [
        "path"
      ]
    },
    "TraceAnswer": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/NodeRef"
        },
        "path": {
          "description": "The shortest root-to-node path — `null` means NOT reachable from the\nrequested root set, which is itself the answer.",
          "anyOf": [
            {
              "$ref": "#/$defs/TracePath"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node"
      ]
    },
    "TraceHop": {
      "type": "object",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        },
        "via": {
          "description": "`import` (with its recorded confidence) or `sees` (structural).",
          "type": "string"
        }
      },
      "required": [
        "node",
        "via"
      ]
    },
    "TracePath": {
      "type": "object",
      "properties": {
        "hops": {
          "description": "File hops, root-side first; each names the edge that led into it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TraceHop"
          }
        },
        "keeper": {
          "description": "For symbol targets: the in-file evidence that finally keeps it — the\nsame keeper vocabulary `used-by` speaks.",
          "anyOf": [
            {
              "$ref": "#/$defs/EdgeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "description": "The rooted file the path starts from.",
          "$ref": "#/$defs/NodeRef"
        },
        "roots": {
          "description": "Which root set anchors this path — absent on the directed form, whose\norigin is the input itself.",
          "anyOf": [
            {
              "$ref": "#/$defs/RootSet"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "root",
        "hops"
      ]
    },
    "UsedByAnswer": {
      "type": "object",
      "properties": {
        "by_color": {
          "description": "The deletion question at a glance: keeper sites per color.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kept_by": {
          "description": "Everything keeping it, most direct first — the exact evidence the\n`unused` judgment counted.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeRef"
          }
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        }
      },
      "required": [
        "node",
        "kept_by",
        "by_color",
        "elided"
      ]
    },
    "UsesAnswer": {
      "type": "object",
      "properties": {
        "elided": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "imports": {
          "description": "Resolved imports out of the node's file (whole file) or none for a\nsymbol whose file needs no imports for it.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportUse"
          }
        },
        "node": {
          "$ref": "#/$defs/NodeRef"
        },
        "references": {
          "description": "Names the node references, each with its use count and — when exactly\none declaration in the legal pool carries the name — its resolution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceUse"
          }
        }
      },
      "required": [
        "node",
        "imports",
        "references",
        "elided"
      ]
    },
    "Verb": {
      "type": "string",
      "enum": [
        "find",
        "describe",
        "uses",
        "used-by",
        "trace",
        "impact",
        "explain"
      ]
    }
  }
}
