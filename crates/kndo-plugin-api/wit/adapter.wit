// kndo-plugin-api v1 — the external-adapter WASM ABI (ADR 0003, RFC 0002/0003, contracts
// core-traits.md §2). Normative spec: docs/contracts/wasm-abi.md — that document is the
// source of truth for what's in v1 scope vs deferred; this file is its concrete shape.
//
// v1 covers ONLY the read side of `LanguageAdapter`: descriptor, claim, extract. A component
// implementing this world has no way to declare a manifest format or participate in import
// resolution — `claim-manifest` always answers false and `resolve` always answers `unresolved`
// on the host bridge, without ever calling into the guest. That is a deliberate, documented
// scope cut (docs/contracts/wasm-abi.md §2), not an oversight: it keeps v1 one-directional
// (guest exports only, no host-import callbacks for `ResolveCtx`), which is what makes a
// pure `wasm32-unknown-unknown` guest — no WASI, no ambient fs/net by construction — sufficient
// for the whole surface. A second version can add `resolve`'s `ResolveCtx` queries as host
// imports once real external-adapter demand for cross-file resolution exists.
package kndo:adapter@0.1.0;

interface types {
    /// 1-indexed line/column span, mirroring `kndo_core::adapter::Span` exactly.
    record span {
        start-line: u32,
        start-col: u32,
        end-line: u32,
        end-col: u32,
    }

    /// v1 subset of `kndo_core::vocab::SymbolKind` — the facets common to every launch
    /// adapter. `Other(name)` (an adapter-specific facet, e.g. Rust's "macro") isn't
    /// representable in v1; a WASM adapter needing one folds it into the nearest kind below
    /// and notes the approximation in a diagnostic.
    enum symbol-kind {
        function,
        method,
        class,
        %interface,
        %struct,
        %enum,
        enum-member,
        type-alias,
        %const,
        %static,
        variable,
        field,
        module,
    }

    record declaration {
        /// Bare name — for a member, the unqualified member name (RFC 0012 §3); ownership is
        /// `member-of`, never string-encoded.
        name: string,
        kind: symbol-kind,
        span: span,
        exported: bool,
        /// The owning type's declared name, when this is a member. `none` for free-standing
        /// declarations.
        member-of: option<string>,
    }

    /// v1 subset of `kndo_core::vocab::RefKind` — the full enum; every variant is cheap to
    /// tag from a syntax tree and reachability treats them uniformly (only `private-type-leak`,
    /// out of v1's analysis surface for a language with no visibility ladder, filters by kind).
    enum ref-kind {
        call,
        read,
        write,
        extend,
        implement,
        override,
        type-use,
    }

    record raw-reference {
        name: string,
        /// The qualifier text of a qualified access (RFC 0012 §9) — `none` for an unqualified
        /// name. v1 does not resolve cross-file qualifiers for a WASM adapter (no `unit-name`
        /// concept yet); a non-`none` value only ever matches this same file's own imports,
        /// which v1 doesn't extract either, so in practice this is always `none` until v2.
        scope-context: option<string>,
        span: span,
        /// The declared symbol this reference executes inside (RFC 0012 §4). `none` = module
        /// load — reproduces every adapter's pre-RFC-0012-§4 behavior exactly.
        within: option<string>,
        kind: ref-kind,
    }

    enum root-kind {
        production,
        test,
        tooling,
    }

    variant raw-root-target {
        whole-file,
        declaration(string),
    }

    record raw-root {
        kind: root-kind,
        target: raw-root-target,
    }

    enum diagnostic-level {
        warn,
        info,
    }

    record diagnostic {
        level: diagnostic-level,
        message: string,
        span: option<span>,
    }

    /// v1 subset of `kndo_core::adapter::FileFacts`: declarations, references, roots,
    /// diagnostics. `imports`, `functions`, `dynamics`, `suppressions`, `unit`/`unit-name`,
    /// `detected-origin` and `test-spans` are all deferred (docs/contracts/wasm-abi.md §2) —
    /// a v1 external adapter can make `unused`/`test-only`/`untested` real for its language
    /// (declarations + references + roots is exactly what reachability needs) but not
    /// cross-file import graphs, duplication/CRAP metrics, or the visibility/origin/test-span
    /// refinements the newer contract stages added.
    record file-facts {
        declarations: list<declaration>,
        references: list<raw-reference>,
        roots: list<raw-root>,
        diagnostics: list<diagnostic>,
    }

    enum file-role {
        production,
        test,
        tooling,
    }

    enum file-origin {
        authored,
        generated,
        vendored,
    }

    record file-class {
        role: file-role,
        origin: file-origin,
    }

    record file-claim {
        class: file-class,
    }

    /// v1 subset of `kndo_core::adapter::AdapterDescriptor`. `visibility-ladder` and
    /// `cycle-policy` aren't exposed — the host bridge fills in the same safe defaults CSS/JSON
    /// use (empty ladder, `Idiomatic` cycle tolerance both levels), and
    /// `resolves-dependency-usage` is fixed `false` (v1 never emits an `ImportsDependency`
    /// edge, having no import extraction at all).
    record adapter-descriptor {
        id: string,
        facts-schema-version: u32,
        file-globs: list<string>,
        grammar-version: string,
    }
}

world adapter {
    use types.{adapter-descriptor, file-claim, file-facts};

    /// Called once at load time; the host caches the result.
    export descriptor: func() -> adapter-descriptor;

    /// Claim & classify a path by name alone — no file content available (mirrors the native
    /// trait's own "fast, name-based" contract).
    export claim: func(path: string) -> option<file-claim>;

    /// Parse one file's content (UTF-8 text; v1 does not carry raw bytes — see
    /// docs/contracts/wasm-abi.md §2) and extract facts. Must not trap on malformed input:
    /// return partial facts + a diagnostic. A guest that traps anyway is caught by the host's
    /// fuel/time budget (RFC 0003 §3) and the file's facts come back empty, with a
    /// host-attributed diagnostic — never a crashed run.
    export extract: func(path: string, content: string) -> file-facts;
}
