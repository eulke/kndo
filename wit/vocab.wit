// The kndo ABI's ONE vocabulary. Every world in this package uses these types; the
// Rust conversion to and from `kndo-contract` lives once per side (guest: kndo-sdk,
// host: kndo-host-wasm). v1 duplicated the vocabulary between its adapter and plugin
// packages so their versions could move independently, and paid for it with a
// per-world conversion module drifting "in sync by prose" — this package is that
// lesson inverted: the vocabulary IS the contract, and worlds evolve by ADDITIVE
// interfaces and sibling worlds within it, never by growing a frozen record (growing
// a record is a breaking change in the component model).
//
// Mirroring rule: these records mirror `kndo-contract` types field-for-field, byte
// spans included (kndo spans are byte offsets, not line/column). Where the contract
// uses an unforgeable id (`DeclarationId`), the wire carries an index into the same
// evidence's declaration list, and the HOST validates on conversion — a bad index
// degrades to a dropped write plus a diagnostic, never a trusted forgery.
package kndo:vocab@1.0.0;

interface types {
    /// Byte-offset span into one file's content, `start..end`.
    record span {
        start: u32,
        end: u32,
    }

    enum confidence {
        possible,
        probable,
        certain,
    }

    /// Mirrors `EvidenceStream` — the optional streams an adapter declares.
    enum evidence-stream {
        comments,
        metrics,
        markers,
        relations,
        qualifiers,
    }

    /// Mirrors `SymbolKind`; `other` carries the adapter's own word verbatim.
    variant symbol-kind {
        function,
        method,
        %type,
        constant,
        variable,
        module,
        other(string),
    }

    /// Mirrors `Reach`: `namespace`, `unit` and `directory` carry their `up`,
    /// `named` the segments of the namespace it spells. `unit` is the unit's
    /// own reach (Kotlin's `internal`, Rust's `pub(crate)`), and the host asks
    /// `seen-from` for its files where no manifest has named the unit.
    variant reach {
        owner,
        file,
        namespace(u32),
        unit(u32),
        directory(u32),
        heirs(bool),
        named(list<string>),
        inherited,
        exported,
    }

    /// Mirrors `Declaration`. `owner` is an index into the SAME file-evidence's
    /// `declarations` list (the wire spelling of `DeclarationId`); host-validated.
    record declaration {
        name: string,
        kind: symbol-kind,
        span: span,
        reach: reach,
        owner: option<u32>,
        exported-as: option<string>,
        /// Mirrors `Declaration::signature`.
        signature: option<string>,
    }

    /// Mirrors `RefKind`.
    enum ref-kind {
        call,
        read,
        write,
        extend,
        implement,
        type-use,
    }

    record reference {
        name: string,
        kind: ref-kind,
        /// Mirrors `Reference::on`: what the name was read from, as written,
        /// and nothing for a bare name. Meaningful only under the
        /// `qualifiers` stream.
        on: option<string>,
        span: span,
    }

    /// Mirrors `ImportTarget` — the specifier as written, tagged by form.
    variant import-target {
        relative(string),
        %package(string),
    }

    record import-binding {
        imported: string,
        local: string,
    }

    /// The target of a `mount` shape: the segment it is mounted as, and the
    /// reach the mount carries, read from the mounting file.
    record mount-point {
        namespace: string,
        reach: reach,
    }

    /// Mirrors `ImportShape`. A type-only import is its bindings at the
    /// `erased` timing — the shape says what is bound, the timing when.
    variant import-shape {
        bindings(list<import-binding>),
        namespace(string),
        side-effect,
        reexport(list<import-binding>),
        reexport-all,
        glob,
        // `include` is a WIT keyword; the % escape keeps the wire name.
        mount(mount-point),
        %include,
    }

    /// Mirrors `Timing` — when an import runs: at module load, when the code
    /// around it does, or never (the type checker alone).
    enum timing {
        load,
        lazy,
        erased,
    }

    record %import {
        target: import-target,
        shape: import-shape,
        span: span,
        confidence: confidence,
        timing: timing,
    }

    enum root-kind {
        production,
        test,
        tooling,
    }

    /// Mirrors `RootTarget`; `declaration` is the same index spelling as `owner`.
    variant root-target {
        whole-file,
        declaration(u32),
    }

    record root {
        target: root-target,
        kind: root-kind,
        confidence: confidence,
    }

    /// Mirrors `MarkerTarget`; `declaration` is the same index spelling as
    /// `owner`.
    variant marker-target {
        file,
        declaration(u32),
    }

    /// Mirrors `Marker`: an attribute, annotation, decorator or pragma as
    /// written — path and top-level arguments — on a declaration or the file.
    /// What it means is the spec's dispatch rules, matched host-side.
    record marker {
        on: marker-target,
        path: string,
        args: list<string>,
        span: span,
    }

    /// Mirrors `RelationKind`.
    enum relation-kind {
        extends,
        implements,
    }

    /// Mirrors `Relation`: a typed link from a declaration (by the same index
    /// spelling as `owner`) to a NAMED type, generics and qualification
    /// stripped. The host resolves the name; a member whose owner promised a
    /// type declaring the same name is a witness of it.
    record relation {
        %from: u32,
        kind: relation-kind,
        to: string,
        span: span,
    }

    /// Mirrors `CommentSpan`: where a comment is, and where its text is. The engine
    /// owns what a `kndo:` pragma inside one means — suppression is free and
    /// identical for a WASM adapter.
    record comment-span {
        span: span,
        text: span,
    }

    record function-metrics {
        cyclomatic: u32,
        loc: u32,
        token-count: u32,
        fingerprints: list<u64>,
    }

    /// Metrics attach by declaration index — the wire spelling of the sink's by-id
    /// attachment.
    record metric-entry {
        declaration: u32,
        metrics: function-metrics,
    }

    enum diagnostic-level {
        info,
        warn,
        error,
    }

    record diagnostic {
        level: diagnostic-level,
        message: string,
        span: option<span>,
    }

    /// Mirrors `RegionMode` — how an embedded region runs: as a module, or as
    /// a classic script whose top-level declarations are the page's globals.
    enum region-mode {
        module,
        script,
    }

    /// Mirrors `EmbeddedRegion` — a span of the file written in another
    /// language, named by the file suffix its extension claims. A host
    /// adapter reports it; the engine extracts it with that extension.
    record embedded-region {
        span: span,
        language: string,
        mode: region-mode,
    }

    /// Mirrors `FileEvidence`, minus `declared` — the declared streams come from the
    /// spec, and the host replays every wire write through a real `EvidenceSink`, so
    /// the pairing rule and every clamp apply to a WASM adapter identically.
    record file-evidence {
        declarations: list<declaration>,
        references: list<reference>,
        imports: list<%import>,
        roots: list<root>,
        markers: list<marker>,
        relations: list<relation>,
        comments: list<comment-span>,
        metrics: list<metric-entry>,
        embedded: list<embedded-region>,
        diagnostics: list<diagnostic>,
    }

    /// Mirrors `CycleTolerance` — whether an import cycle among this
    /// language's files is a hazard worth a finding.
    enum cycle-tolerance {
        tolerated,
        hazard,
    }

    /// Mirrors `Trigger` — what a dispatch rule watches for: a marker whose
    /// path matches the pattern (`*` matches any run), when given an argument
    /// matching `arg`, and when given on a declaration of `target`.
    record marker-trigger {
        path: string,
        arg: option<string>,
        target: option<symbol-kind>,
    }

    /// Mirrors `InFiles` — which files a name rule reads, by the color the
    /// project rooted the file with.
    variant in-files {
        any,
        rooted(root-kind),
        not-rooted(root-kind),
    }

    /// Mirrors the `Name` trigger — a declaration whose own name matches the
    /// pattern, optionally narrowed to one symbol kind and to the files a
    /// role qualifies.
    record name-trigger {
        pattern: string,
        kind: option<symbol-kind>,
        in-files: in-files,
    }

    /// Mirrors the `Relation` trigger — a type declaring a relation of this
    /// kind to a base matching `to`.
    record relation-trigger {
        kind: relation-kind,
        to: string,
    }

    /// Mirrors the `MemberOf` trigger. A trigger tree is recursive and a WIT
    /// variant cannot name itself, so a rule carries its trigger as a FLAT
    /// list of nodes with the root at index 0, and `owner` is the index of
    /// the node that must match the member's owner. An index that is not a
    /// smaller one than the node's own is malformed: the host rejects the
    /// rule rather than following a cycle.
    record member-of-node {
        owner: u32,
        %name: string,
    }

    /// Mirrors the `ExternalWitness` trigger — the members a base outside the
    /// project requires of whatever reaches it.
    record external-witness-trigger {
        base: string,
        members: list<string>,
    }

    variant trigger-node {
        marker(marker-trigger),
        %name(name-trigger),
        relation(relation-trigger),
        member-of(member-of-node),
        external-witness(external-witness-trigger),
    }

    /// Mirrors `Effect` — a root of a color, an exemption from `unused`, a
    /// generator's ownership of the whole file, or a surface an owner
    /// promised.
    variant effect {
        root(root-kind),
        exempt,
        generated,
        witness,
    }

    /// Mirrors `DispatchRule`.
    record dispatch-rule {
        /// The trigger tree, flattened: the root is the LAST node, and every
        /// `member-of` owner points at an earlier one.
        when: list<trigger-node>,
        then: effect,
        confidence: confidence,
    }

    /// Mirrors `Rung` — one reach a language can spell with a keyword.
    enum rung {
        owner,
        file,
        namespace,
        unit,
        exported,
    }

    /// Mirrors `Bearer` — which declarations a step's keyword exists for.
    enum bearer {
        %any,
        free,
        member,
    }

    /// Mirrors `Step` — one rung under the language's own word for it.
    record step {
        rung: rung,
        word: string,
        bearer: bearer,
    }

    /// Mirrors `PublishedSurface` — what a unit of the ecosystem publishes.
    enum published-surface {
        exports,
        entries,
    }

    /// Mirrors `ExtensionSpec` — the ONE manifest for every capability, claims
    /// already derived (the guest-side builder does the extension-to-glob
    /// derivation; the wire carries the finished list). `coordinate` is identity
    /// AND provenance; the `kndo:` namespace is reserved for built-ins — the host
    /// rejects any external component claiming it at load. `conducts` is the
    /// conduct-stage bit: with it false, the activation/mutates-graph/rules half
    /// is inert and the component never appears in the round; a hand-rolled guest
    /// is forced by the record's shape to state every gate either way.
    record extension-spec {
        coordinate: string,
        version: u32,
        suffixes: list<string>,
        /// The reaches the language can spell, narrowest first — the one
        /// fact behind internal-only; empty keeps it silent.
        ladder: list<step>,
        /// What a unit of the ecosystem publishes — `exports` keeps
        /// internal-only's Exported rung silent.
        published-surface: published-surface,
        /// Whether import cycles are a hazard here — `cyclic` reads it.
        import-cycles: cycle-tolerance,
        /// What the language's markers mean — the host's dispatch reads it.
        dispatch: list<dispatch-rule>,
        claims: list<string>,
        emits: list<evidence-stream>,
        manifests: list<string>,
        /// Files read for roots only — never packages, dependencies or mentions.
        launchers: list<string>,
        /// Paths the language's own tool never compiles: discovered, never
        /// claimed by this extension.
        ignores: list<string>,
        conducts: bool,
        activation: activation,
        mutates-graph: bool,
        dependencies: list<string>,
        requested-file-access: list<string>,
        rules: list<rule-descriptor>,
        reads-reports: list<string>,
    }

    /// Mirrors `PackageEntry`.
    record package-entry {
        name: string,
        entry: option<string>,
        dir: string,
    }

    /// Mirrors `Resolution`.
    variant resolution {
        file(string),
        files(list<string>),
        unresolved,
    }

    /// Mirrors `ProjectRoot` — a manifest-declared entry point, already resolved.
    record project-root {
        file: string,
        kind: root-kind,
        confidence: confidence,
    }

    /// Mirrors `ActivationRule`.
    variant activation-rule {
        file-exists(string),
        manifest-dependency(string),
    }

    /// Mirrors `Activation`. `any-rule([])` is the deliberate dependency-only
    /// posture: a component that can never self-activate.
    variant activation {
        always,
        any-rule(list<activation-rule>),
    }

    record rule-descriptor {
        name: string,
        description: string,
    }

    /// Mirrors `PluginSeverity` — a plugin's own vocabulary, mapped host-side into
    /// the advisory channel; a guest can never construct a gate-eligible finding.
    enum conduct-severity {
        error,
        warning,
        info,
    }

    /// Mirrors `PluginTarget`.
    record symbol-ref {
        path: string,
        name: string,
    }

    variant conduct-target {
        file(string),
        symbol(symbol-ref),
    }

    /// Mirrors `DeclaredSymbol` — one declaration as conduct sees it: where it
    /// is, its name, its kind, and the name of the declaration it belongs to.
    record declared-symbol {
        path: string,
        name: string,
        kind: symbol-kind,
        owner: option<string>,
    }

    record contributed-root {
        target: conduct-target,
        kind: root-kind,
        confidence: confidence,
    }

    record contributed-finding {
        rule: string,
        severity: conduct-severity,
        target: conduct-target,
        /// The extension's own claim about this finding — a fact parsed from a
        /// lockfile is certain, a heuristic possible; carried verbatim.
        confidence: confidence,
        message: string,
    }

    /// One line or function record as the coverage report states it — the wire
    /// level of the contract's `CoverageRecords` (re-exported by `kndo-coverage`). Paths are the report's own,
    /// separator-normalized; the host maps them against the project and builds the
    /// line tables (a guest never sees source contents).
    record coverage-record {
        path: string,
        line: u32,
        hits: u64,
    }

    record coverage-records {
        lines: list<coverage-record>,
        functions: list<coverage-record>,
    }
}
